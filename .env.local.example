# Hetzner Experiments Inference API — generate a token at
# https://experiments.hetzner.com (Apps -> Inference -> Create API Token)
HETZNER_INFERENCE_API_KEY=changeme

# Redis connection string (redis:// or rediss://) for chatbot rate limiting.
# Get it from Vercel -> Storage -> your database -> connection URL.
# Optional: without it, the chatbot still runs, just with rate limiting disabled.
UPSTASH_REDIS_REDIS_URL=

# Optional, testing only: lets the red-team harness bypass the rate limit when sent
# as the x-red-team-key header. NEVER set this in production.
# RED_TEAM_KEY=
