#!/bin/sh
# Blocks direct pushes to protected branches

REMOTE="$1"
PROTECTED="main develop"

while read LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  BRANCH=$(echo "$REMOTE_REF" | sed 's|refs/heads/||')

  for PROTECTED_BRANCH in $PROTECTED; do
    if [ "$BRANCH" = "$PROTECTED_BRANCH" ]; then
      echo ""
      echo "  pre-push: direct push to '$BRANCH' is not allowed."
      echo ""
      echo "  Create a feature branch and open a pull request instead:"
      echo "    git checkout -b feat/my-change"
      echo "    git push origin feat/my-change"
      echo ""
      exit 1
    fi
  done
done

exit 0
